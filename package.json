{
  "name": "auto-qa",
  "version": "0.1.0",
  "scripts": {
    "snapshot": "tsx src/cli/snapshot.ts",
    "typecheck": "tsc --noEmit",
    "parse": "tsx src/cli/parse.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "tools": "tsx src/cli/tools.ts",
    "match": "tsx src/cli/match.ts",
    "demo": "tsx examples/demo-app/server.ts",
    "explore": "tsx src/cli/explore.ts",
    "generate": "tsx src/cli/generate.ts",
    "execute": "tsx src/cli/execute.ts",
    "auto-qa": "tsx src/cli/auto-qa.ts",
    "demo:workbook": "tsx examples/demo-app/make-workbook.ts"
  },
  "description": "Manual test cases to Playwright automation, using Playwright MCP without an AI API",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/mcp": "0.0.83",
    "exceljs": "4.4.0",
    "handlebars": "4.7.9",
    "playwright": "1.64.0-alpha-1790635538000",
    "prettier": "3.9.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.64.0-alpha-1790635538000",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
