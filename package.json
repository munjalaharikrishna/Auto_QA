{
  "name": "auto-qa",
  "version": "0.1.0",
  "scripts": {
    "snapshot": "tsx src/cli/snapshot.ts",
    "typecheck": "tsc --noEmit",
    "parse": "tsx src/cli/parse.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "tools": "tsx src/cli/tools.ts"
  },
  "description": "Manual test cases to Playwright automation, using Playwright MCP without an AI API",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/mcp": "0.0.83",
    "playwright": "1.64.0-alpha-1790635538000",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
