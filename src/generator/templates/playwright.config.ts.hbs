import { existsSync } from 'node:fs';
import path from 'node:path';
import { defineConfig, devices } from '@playwright/test';

// BASE_URL, TEST_USERNAME, TEST_PASSWORD… come from the environment or a git-ignored .env file.
const envFile = path.join(__dirname, '.env');
if (existsSync(envFile)) process.loadEnvFile(envFile);

export default defineConfig({
  testDir: './tests',
  outputDir: './reports/test-results',
  reporter: [['list'], ['html', { outputFolder: 'reports/html', open: 'never' }], ['json', { outputFile: 'reports/results.json' }]],
  use: {
    baseURL: process.env.BASE_URL ?? {{{quote baseUrl}}},
    testIdAttribute: {{{quote testIdAttribute}}},
    screenshot: 'only-on-failure',
    trace: 'retain-on-failure',
  },
  projects: [{ name: 'chromium', use: { ...devices['Desktop Chrome'], channel: 'chrome' } }],
});
